# ---------------------------------------------------------------------------
# Local agent configuration. THIS LINE IS LOAD-BEARING.
#
# .claude/settings.local.json records the exact shell commands that were
# approved during development, and those commands embed the environment they
# ran with -- including a live PeopleWorks Copilot API token. It is a local
# permission cache, never a repository artefact.
#
# settings.json (shared, no secrets) is tracked; only the .local. variant is not.
# ---------------------------------------------------------------------------
.claude/settings.local.json

# .NET build output
bin/
obj/
[Dd]ebug/
[Rr]elease/
*.user

# Local SDK home created when the CLI is exercised from this directory
.dotnet_cli_home/

# NuGet pack output / local tool install
nupkg/
out/
*.nupkg
*.snupkg

# Publish output
publish/
[Pp]ublish/

# IDE / OS
.vs/
.idea/
*.swp
.DS_Store
Thumbs.db

# Test / tooling artifacts
TestResults/
*.trx
.playwright-mcp/

# Generated explainers. `xaflogic explain` writes one next to the project it read, and it is
# derived output like everything else in .xaflogic-output/.
*-explainer.html
coverage*.xml
*.coverage

# Extraction output. `xaflogic extract` writes .xaflogic-output/ into the project
# it analyzed, and .xaflogicexplainer holds the change-detection hash -- neither
# belongs to anyone but the machine that produced it.
.xaflogic-output/
.xaflogicexplainer

# The DevExpress ground-truth catalog is generated locally by licensees from
# their own installation (see tools/XafLogicExplainer.DxCatalog). Nothing
# derived from DevExpress sources is ever committed to this repository.
#
# Matched by file extension, NOT by a `catalog/` directory rule. That rule matched
# any directory of that name at any depth, so it silently swallowed
# src/XafLogicExplainer.Core/Catalog/ -- three source files were never committed,
# and every clean checkout failed to compile while the local build sailed on
# because the files were still sitting on disk.
*.dxcatalog.json

# Working notes and scratch. One `git add -A` from the root is all it takes to
# publish something that was never meant to leave the machine.
temp/
scratch/

# ---------------------------------------------------------------------------
# Pre-0.9 presentation material, held back rather than deleted.
#
# Both are in Spanish and describe the original "sync to PeopleWorks Copilot"
# pitch, which the README no longer makes. Publishing them as-is would be the
# repository's only long-form documentation contradicting its own front page.
# Delete these two lines once they have been reworked in English.
# ---------------------------------------------------------------------------
docs/XAF_Logic_Explainer_Presentation.pptx
docs/xaflogic-cli-guide.html

# ---------------------------------------------------------------------------
# Built by the Pages workflow, which copies docs/assets into it so the site can
# reference figures with a same-origin path. Committing it would give every
# figure a second copy, free to drift from the one the README uses.
#
# Also written by site/capture-screenshots.py while it works.
# ---------------------------------------------------------------------------
site/assets/
site/.report.html

# ---------------------------------------------------------------------------
# Rendered video, and the scratch that produces it.
#
# The scenes, their posters and the captured still ARE committed: a poster is
# how a copy change gets reviewed, and the still saves every reader a dotnet
# run. The mp4s are not — they are megabytes that rebuild from those three in
# one command, and every wording tweak would commit them all again.
# ---------------------------------------------------------------------------
docs/Blog/video/render/
docs/Blog/video/.report.html
__pycache__/
*.pyc
