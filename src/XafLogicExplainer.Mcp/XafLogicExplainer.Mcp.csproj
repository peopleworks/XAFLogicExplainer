<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The MCP server: lets any agent that speaks Model Context Protocol interrogate an XAF
    application directly, instead of reading a generated file about it.

    Packaged as a dotnet tool so `dnx XafLogicExplainer.Mcp` runs it with nothing installed, and
    referenced by the CLI so `xaflogic mcp` runs the same server. One implementation, two ways in.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>xaflogic-mcp</AssemblyName>
    <RootNamespace>XafLogicExplainer.Mcp</RootNamespace>

    <PackAsTool>true</PackAsTool>
    <ToolCommandName>xaflogic-mcp</ToolCommandName>
    <PackageId>XafLogicExplainer.Mcp</PackageId>
    <Description>Model Context Protocol server for DevExpress XAF applications. Exposes an application's entities, controllers, actions, business rules and Model Editor customizations as MCP tools, so an agent can query a specific XAF codebase instead of guessing about it. Reads source with Roslyn; no DevExpress licence required.</Description>

    <!-- PackAsTool already contributes DotnetTool, which is what makes `dnx` work. McpServer is
         additional, and is what lets the MCP registry find and describe this package. -->
    <PackageType>McpServer</PackageType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\XafLogicExplainer.Core\XafLogicExplainer.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="2.1.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
  </ItemGroup>

  <!-- The registry reads this manifest out of the package itself, so it has to be packed. -->
  <ItemGroup>
    <None Include=".mcp/server.json" Pack="true" PackagePath="/.mcp/" />
  </ItemGroup>

  <!--
    This package carries its own README instead of the repository one, and that is load-bearing.

    It ends with `mcp-name: io.github.peopleworks/xaf-logic-explainer`. The MCP registry reads that
    line out of the published package to confirm that whoever submits the registry entry also owns
    the NuGet package. It looks like decoration; removing it breaks registry publishing, and it
    breaks it quietly — the next release simply stops being accepted.

    Overriding the item is not enough: Directory.Build.props already contributes the repository
    README at the package root, so it is removed first to avoid two files claiming that path.
  -->
  <ItemGroup>
    <None Remove="$(MSBuildThisFileDirectory)..\..\README.md" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
