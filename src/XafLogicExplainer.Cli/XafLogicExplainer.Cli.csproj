<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The `xaflogic` command. Installed as a global .NET tool:
        dotnet tool install -g XafLogicExplainer.Cli
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>xaflogic</AssemblyName>
    <RootNamespace>XafLogicExplainer.Cli</RootNamespace>

    <PackAsTool>true</PackAsTool>
    <ToolCommandName>xaflogic</ToolCommandName>
    <PackageId>XafLogicExplainer.Cli</PackageId>
    <Description>Command-line tool that extracts functional documentation from DevExpress XAF projects using Roslyn, and makes it available to AI coding agents. Reads entities, controllers, actions, module setup, navigation and Model Editor (.xafml) customizations from source -- no compilation of the target project, no DevExpress reference required. Supports XPO and EF Core, incremental change detection, and multi-project solutions.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\XafLogicExplainer.Core\XafLogicExplainer.Core.csproj" />
    <ProjectReference Include="..\XafLogicExplainer.CopilotSync\XafLogicExplainer.CopilotSync.csproj" />
    <ProjectReference Include="..\XafLogicExplainer.Mcp\XafLogicExplainer.Mcp.csproj" />
    <!-- So `xaflogic catalog build` works without installing a second tool. The standalone
         xafcatalog executable remains available for scripting. -->
    <ProjectReference Include="..\..\tools\XafLogicExplainer.DxCatalog\XafLogicExplainer.DxCatalog.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.2.0-preview.1.26063.2" />
    <PackageReference Include="Spectre.Console" Version="0.52.0" />
    <PackageReference Include="System.CommandLine" Version="2.0.0-beta4.22272.1" />
  </ItemGroup>

  <!-- MSBuild integration for projects that take a PackageReference on this package.
       NuGet only auto-imports build\<PackageId>.targets, so the file name must track PackageId.
       Packaging verification in CI fails the build if these ever drift apart. -->
  <ItemGroup>
    <None Include="build\XafLogicExplainer.Cli.targets" Pack="true" PackagePath="build\" />
  </ItemGroup>

</Project>
